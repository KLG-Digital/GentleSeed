# Optional file: docker compose works without .env (copy it to ".env" only to change a setting).
# Port used to reach GentleSeed (1853 by default):
WEB_PORT=1853
# Extra host names (comma separated) accepted when no account is set, e.g. nas.example.org
# WEB_ALLOWED_HOSTS=
# HTTPS sessions behind an HTTPS reverse proxy (also add it to the service environment in Compose):
# WEB_HTTPS_ONLY=true
# Radarr/Sonarr connections, account and theme are set in the web interface, not here.
